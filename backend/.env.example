APP_NAME=classvortex

APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# MongoDB — local dev or Atlas cluster
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=attendance_db

# JWT — change to a strong random secret in production
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated origins. In production, use your Vercel domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

EXPORT_DIRECTORY=exports

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3