# AttendVortex Frontend Environment Variables
# Point this to your FastAPI backend base URL (with or without /api/v1).
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production example (set in Render / Vercel Environment Variables):
# NEXT_PUBLIC_API_URL=https://<your-render-backend-url>.onrender.com/api/v1

# Demo Mode — shows the "Continue as Demo" button on the login page.
# Enable in preview/staging only; keep unset/false in production.
# When enabled, the frontend calls POST /api/v1/auth/demo (no password).
NEXT_PUBLIC_DEMO_MODE=true
