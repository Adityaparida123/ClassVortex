# AttendVortex Frontend Environment Variables
# Point this to your FastAPI backend base URL (including /api/v1).
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Vercel production example (set in the Vercel dashboard, not committed):
# NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com/api/v1